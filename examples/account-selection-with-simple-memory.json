      ],
      "parameters": {
        "model": {
          "mode": "id",
          "value": "SELECT_FROM_YOUR_ACCOUNT_CATALOG"
        }
      }
    },
    {
      "id": "memory",
      "name": "Account Scoped Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        1100,
        240
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $workflow.id + ':' + $json.selectedAccount + ':' + $json.conversationId }}",
        "contextWindowLength": 10
      }
    },
    {
      "id": "agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
