      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "limits-a",
      "name": "Limits A",
      "type": "n8n-nodes-codex-chat.codexAccountTools",
      "typeVersion": 1,
      "position": [
        200,
        -100
      ],
      "parameters": {
        "operation": "getLimits"
      }
    },
    {
      "id": "limits-b",
      "name": "Limits B",
      "type": "n8n-nodes-codex-chat.codexAccountTools",
      "typeVersion": 1,
      "position": [
        200,
        100
      ],
      "parameters": {
        "operation": "getLimits"
      }
    },
    {
      "id": "merge",
      "name": "Wait for Both Accounts",
