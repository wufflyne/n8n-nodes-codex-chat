# Assemble only previously compiled and tested output from the bounded build runner.
FROM docker.io/library/node:26.12.1-bookworm-slim@sha256:88e480776c6149ff1d098cd304f44bf18057fb5d284a3329b78162d29821e28c
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=256
WORKDIR /opt/codex-wire
COPY --chown=node:node runtime/ ./
USER node
EXPOSE 8787 8788
ENTRYPOINT ["node", "dist/gateway-cli.js"]
CMD ["serve", "--config", "/etc/codex-wire/gateway.json"]
