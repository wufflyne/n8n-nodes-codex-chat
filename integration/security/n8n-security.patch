+/** Bounds shared by the parsed-body and low-level MCP entry points. */
+export const MCP_MAX_BODY_BYTES: number = 1024 * 1024;
+export const MCP_MAX_TOOL_ELEMENTS: number = 10000;
+export const MCP_MAX_BATCH_MESSAGES: number = 100;
+
+export function assertMcpToolInputLimit(value: unknown): void {
+	let count = 0;
+	const pending: unknown[] = [value];
+	while (pending.length > 0) {
+		const current = pending.pop();
+		if (current === null || typeof current !== 'object') continue;
+		for (const key in current) {
+			if (!Object.prototype.hasOwnProperty.call(current, key)) continue;
+			if (++count > MCP_MAX_TOOL_ELEMENTS) {
+				throw new RangeError('MCP tool arguments exceed the 10000-element limit');
+			}
+			const child = (current as Record<string, unknown>)[key];
+			if (child !== null && typeof child === 'object') pending.push(child);
+		}
+	}
+}
+
+export function assertMcpMessageLimits(value: unknown): void {
+	const messages: unknown[] = Array.isArray(value) ? value : [value];
+	if (messages.length > MCP_MAX_BATCH_MESSAGES) {
+		throw new RangeError('MCP request exceeds the 100-message batch limit');
+	}
+	for (const message of messages) {
+		if (message === null || typeof message !== 'object') continue;
+		const request = message as Record<string, unknown>;
+		if (request.method !== 'tools/call' || request.params === null || typeof request.params !== 'object') continue;
+		assertMcpToolInputLimit((request.params as Record<string, unknown>).arguments);
+	}
+}
