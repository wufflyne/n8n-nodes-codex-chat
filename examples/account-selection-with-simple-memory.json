      "typeVersion": 3.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "mode": "append"
      }
    },
    {
      "id": "select",
      "name": "Select One Account",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "const a=$('Limits A').first().json, b=$('Limits B').first().json; const selectedAccount=a.routing.decision==='allowed'?'a':b.routing.decision==='allowed'?'b':null; if(!selectedAccount) throw Error('No explicitly allowed account. Unknown limits stop this example.'); return [{json:{selectedAccount,reason:'explicit_permission',conversationId:'example-conversation',firstItemOnly:true}}];"
      }
    },
    {
      "id": "selector",
      "name": "Model Selector",
      "type": "@n8n/n8n-nodes-langchain.modelSelector",
      "typeVersion": 1,
      "position": [
        800,
        200
      ],
      "parameters": {
        "numberInputs": 2,
        "rules": {
          "rule": [
            {
              "modelIndex": 1,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "select-a",
                    "leftValue": "={{ $json.selectedAccount }}",
                    "rightValue": "a",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "modelIndex": 2,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "select-b",
                    "leftValue": "={{ $json.selectedAccount }}",
                    "rightValue": "b",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      }
    },
    {
      "id": "model-a",
      "name": "Model A",
      "type": "n8n-nodes-codex-chat.codexChatModel",
      "typeVersion": 1,
      "position": [
        650,
        400
      ],
      "parameters": {
        "model": {
          "mode": "id",
          "value": "SELECT_FROM_YOUR_ACCOUNT_CATALOG"
        }
      }
    },
    {
      "id": "model-b",
      "name": "Model B",
      "type": "n8n-nodes-codex-chat.codexChatModel",
