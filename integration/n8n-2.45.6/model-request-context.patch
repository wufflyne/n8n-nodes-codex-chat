+import type { AgentTurnRequest } from './agent-turn-execution.service';
+const load = () =>
+	require('/opt/codex-wire-context/dist/integration/n8n-context.js') as {
+		installFromEnvironment(): Promise<unknown>;
+		withServerRun<T>(
+			identity: Record<string, string | number | undefined>,
+			action: () => T,
+		): Promise<Awaited<T>>;
+		registerAgentRevision(agent: object, revision: unknown): void;
+		agentRevision(agent: object): string;
+		currentParentOperationId(): string | undefined;
+	};
+export async function ensureCodexWireContext(): Promise<void> {
+	if (process.env.N8N_CODEX_CONTEXT_CONFIG_FILE) await load().installFromEnvironment();
+}
+export function registerCodexWireRevision(agent: object, revision: unknown): void {
+	if (process.env.N8N_CODEX_CONTEXT_CONFIG_FILE) load().registerAgentRevision(agent, revision);
+}
+export async function withCodexWireTurn<T>(
+	turn: AgentTurnRequest,
+	executionId: string,
+	hostIssuedAt: number,
+	agent: object,
+	action: () => T,
+): Promise<Awaited<T>> {
+	if (!process.env.N8N_CODEX_CONTEXT_CONFIG_FILE) return await action();
+	const r = turn.recording;
+	return await load().withServerRun(
+		{
+			projectId: r.projectId,
+			agentRevision: load().agentRevision(agent),
+			conversationId: r.threadId,
+			branchId: r.threadId,
+			turnId: executionId,
+			hostRunId: executionId,
+			hostIssuedAt,
+		},
+		action,
+	);
+}
+
+export async function withCodexWireWorkflow<T>(
+	identity: Record<string, string | number | undefined>,
+	agent: object,
+	action: () => T,
+): Promise<Awaited<T>> {
+	if (process.env.N8N_CODEX_CONTEXT_CONFIG_FILE && identity.hostIssuedAt === undefined) {
+		if (typeof identity.hostRunId !== 'string' || !identity.hostRunId)
+			throw new Error('A durable workflow execution is required for the matched lifecycle hook.');
+		const { Container } = await import('@n8n/di');
+		const { ExecutionRepository } = await import('@n8n/db');
+		const execution = await Container.get(ExecutionRepository).findOne({
+			where: { id: identity.hostRunId },
+			select: { startedAt: true },
+		});
+		const hostIssuedAt = execution?.startedAt?.getTime();
+		if (!Number.isSafeInteger(hostIssuedAt) || !hostIssuedAt || hostIssuedAt <= 0)
+			throw new Error('The workflow execution has no durable admission timestamp.');
+		identity = { ...identity, hostIssuedAt };
+	}
+	return await withCodexWireScope(identity, agent, action);
+}
+export function currentCodexWireParent(): string | undefined {
+	return process.env.N8N_CODEX_CONTEXT_CONFIG_FILE ? load().currentParentOperationId() : undefined;
+}
+export async function withCodexWireScope<T>(
+	identity: Record<string, string | number | undefined>,
+	agent: object,
+	action: () => T,
+): Promise<Awaited<T>> {
+	if (!process.env.N8N_CODEX_CONTEXT_CONFIG_FILE) return await action();
+	if (!identity.hostRunId)
+		throw new Error('A durable host execution is required for the matched lifecycle hook.');
+	return await load().withServerRun(
+		{ ...identity, agentRevision: load().agentRevision(agent) },
+		action,
+	);
+}
