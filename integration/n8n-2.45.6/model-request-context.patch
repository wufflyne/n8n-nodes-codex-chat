+/** Server-owned lifecycle hook; never configured from agent prompts or custom headers. */
+export interface ModelOperationContext {
+	version: 1;
+	installationId: string;
+	projectId: string;
+	agentRevision: string;
+	conversationId: string;
+	branchId: string;
+	runId: string;
+	turnId: string;
+	operationId: string;
+	operationIssuedAt: number;
+	kind: 'turn' | 'title' | 'helper' | 'subagent' | 'compaction';
+	cause?: 'generation' | 'empty_turn_retry' | 'regeneration';
+	parentOperationId?: string;
+}
+export interface ModelRequestHooks {
+	prepare(
+		input: {
+			runId: string;
+			agentRevision?: string;
+			parentOperationId?: string;
+			previous?: ModelOperationContext;
+			cause?: ModelOperationContext['cause'];
+			kind?: ModelOperationContext['kind'];
+		},
+		persist: (context: ModelOperationContext) => Promise<void>,
+	): Promise<ModelOperationContext | undefined>;
+	run<T>(context: ModelOperationContext | undefined, action: () => T): T;
+	decorateModel<T>(model: T, kind?: ModelOperationContext['kind']): T;
+	decorateFetch(fetch: typeof globalThis.fetch): typeof globalThis.fetch;
+}
+export function modelRequestHooks(): ModelRequestHooks | undefined {
+	return (globalThis as Record<symbol, unknown>)[Symbol.for('n8n.model-request-context.v1')] as
+		| ModelRequestHooks
+		| undefined;
+}
